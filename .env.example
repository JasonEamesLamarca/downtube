# DownTube configuration. Copy to .env (git-ignored) and fill in real values.
# Every value below is a placeholder. Never commit a real .env.

# ---- Compose-only settings (used by docker-compose.yml, not read by the app) ----
# Host port that maps to the container's 8092.
DOWNTUBE_PORT=8092
# Host folder mounted at /archive. Relative paths resolve from this directory.
DOWNTUBE_ARCHIVE_HOST_PATH=./archive
# Uid/gid the container runs as. Host ./data ./logs ./temp and the archive folder must be owned by these.
# Check with: id -u && id -g
PUID=1000
PGID=1000

# ---- Application settings (see docs/architecture/CONTRACTS.md section 9) ----
# Google sign-in (client ID/secret) and allowed accounts can instead be entered in the app's
# first-run setup page (/setup) — leave GOOGLE_CLIENT_* and DOWNTUBE_ALLOWED_EMAILS empty for that.

# Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
DOWNTUBE_SECRET_KEY=replace-with-generated-secret-at-least-32-chars

# Google OAuth web client credentials (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of the app. It must equal the authorized redirect origin registered in Google.
# Redirect URI = <DOWNTUBE_BASE_URL>/api/auth/callback
# Google rejects raw private IP addresses and plain-http non-localhost origins. Use either:
#   - http://localhost:8092 with an SSH tunnel (ssh -L 8092:localhost:8092 user@host), or
#   - an HTTPS hostname under a domain you control (reverse proxy with TLS).
DOWNTUBE_BASE_URL=http://localhost:8092

# Comma-separated Google accounts allowed to sign in. The first login becomes admin.
# Optional: comma-separated admins (otherwise the first user to log in becomes admin)
# DOWNTUBE_ADMIN_EMAILS=you@example.com

# Optional: reverse proxies (CIDRs) whose X-Real-IP / X-Forwarded-For / X-Forwarded-Proto headers
# are trusted. Behind Synology DSM's reverse proxy with the port bound to 127.0.0.1, use 172.16.0.0/12.
# DOWNTUBE_TRUSTED_PROXIES=127.0.0.1/32

# Optional: host address the web port is published on (127.0.0.1 = only a local reverse proxy can reach it)
# DOWNTUBE_BIND=0.0.0.0

DOWNTUBE_ALLOWED_EMAILS=

# Container paths (defaults shown; change only if you change the volume mounts).
DOWNTUBE_DATA_DIR=/data
DOWNTUBE_TEMP_DIR=/temp
DOWNTUBE_LOG_DIR=/logs
# Comma-separated container paths the app may write to.
DOWNTUBE_STORAGE_MOUNTS=/archive
# Initial archive root (changeable in the UI, within the mounts above).
DOWNTUBE_ARCHIVE_ROOT=/archive
# Display-only hint shown in the UI (the host path, for your reference). Not used for file access.
DOWNTUBE_HOST_ARCHIVE_PATH=/path/on/host/to/archive

# Optional: true/false. Omit to auto-detect (secure cookies when DOWNTUBE_BASE_URL is https).
# DOWNTUBE_COOKIE_SECURE=false
DOWNTUBE_LOG_LEVEL=INFO
DOWNTUBE_YTDLP_BIN=yt-dlp
DOWNTUBE_FFPROBE_BIN=ffprobe
TZ=UTC
